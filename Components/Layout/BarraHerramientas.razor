@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject AccionesPantalla Acciones
@inject IJSRuntime JS

@*
    Barra de herramientas común a todas las pantallas (la del mockup, debajo de
    la barra de título): menú · actualizar · exportar · imprimir · reportes.

    Los botones que dependen de la pantalla (actualizar, exportar) invocan lo que
    esa pantalla anunció en AccionesPantalla; la barra nunca sabe qué datos hay
    detrás. Los íconos son de Font Awesome Free, servido desde wwwroot/lib.
*@

<div class="barra-herramientas" role="toolbar" aria-label="Barra de herramientas">
    <button type="button" class="barra-herramientas__boton"
            title="@(MenuPlegado ? "Mostrar el menú" : "Ocultar el menú")"
            aria-pressed="@(MenuPlegado ? "false" : "true")"
            @onclick="AlAlternarMenu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <span class="barra-herramientas__separador" aria-hidden="true"></span>

    <button type="button" class="barra-herramientas__boton"
            title="Actualizar"
            disabled="@_actualizando"
            @onclick="ActualizarAsync">
        <i class="fa-solid fa-arrow-rotate-right @(_actualizando ? "fa-spin" : null)" aria-hidden="true"></i>
    </button>

    <span class="barra-herramientas__separador" aria-hidden="true"></span>

    <button type="button" class="barra-herramientas__boton"
            title="@TituloExportar"
            disabled="@(!Acciones.ExportarHabilitado || _exportando)"
            @onclick="ExportarAsync">
        <i class="fa-solid @(_exportando ? "fa-spinner fa-spin" : "fa-download")" aria-hidden="true"></i>
    </button>

    <button type="button" class="barra-herramientas__boton"
            title="Imprimir"
            @onclick="ImprimirAsync">
        <i class="fa-solid fa-print" aria-hidden="true"></i>
    </button>

    @if (_puedeVerReportes)
    {
        <a class="barra-herramientas__boton" href="/reportes" title="Reportes">
            <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
        </a>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter] public bool MenuPlegado { get; set; }

    [Parameter] public EventCallback AlAlternarMenu { get; set; }

    /// <summary>
    /// Plan B de "Actualizar" para las pantallas que no anuncian su propia
    /// recarga: el layout vuelve a construir la página desde cero.
    /// </summary>
    [Parameter] public EventCallback AlReconstruirPagina { get; set; }

    private bool _actualizando;
    private bool _exportando;
    private bool _puedeVerReportes;

    /// <summary>
    /// El botón de exportar se queda visible aunque la pantalla no exporte, pero
    /// deshabilitado y diciendo por qué: un botón que desaparece y aparece según la
    /// pantalla mueve los demás de lugar.
    /// </summary>
    private string TituloExportar => Acciones.Exportar is null
        ? "Esta pantalla no tiene exportación"
        : Acciones.ExportarHabilitado
            ? Acciones.TextoExportar ?? "Exportar"
            : "No hay datos para exportar";

    protected override void OnInitialized() => Acciones.Cambio += AlCambiarAcciones;

    protected override async Task OnParametersSetAsync()
    {
        // El botón de reportes se oculta a quien no tiene GENERAR_REPORTES, con la
        // misma regla del menú lateral (el permiso se lee de la propia página).
        _puedeVerReportes = EstadoAutenticacion is not null
            && MapaPantallas.PuedeAbrir((await EstadoAutenticacion).User, "/reportes");
    }

    private async Task ActualizarAsync()
    {
        _actualizando = true;

        try
        {
            if (Acciones.Actualizar is { } actualizar)
            {
                await actualizar();
            }
            else
            {
                await AlReconstruirPagina.InvokeAsync();
            }
        }
        finally
        {
            _actualizando = false;
        }
    }

    private async Task ExportarAsync()
    {
        if (Acciones.Exportar is not { } exportar)
        {
            return;
        }

        _exportando = true;

        try
        {
            await exportar();
        }
        finally
        {
            _exportando = false;
        }
    }

    /// <summary>
    /// Imprime la pantalla tal como se ve, sin la barra de título, esta barra ni
    /// el menú (lo resuelve css/impresion.css). En Certificados sale solo el
    /// certificado, igual que con su propio botón de imprimir.
    /// </summary>
    private async Task ImprimirAsync() => await JS.InvokeVoidAsync("window.print");

    /// <summary>
    /// La pantalla publica sus acciones mientras se dibuja ella misma, no esta
    /// barra; por eso se pide el redibujo a través de InvokeAsync, que lo encola
    /// en el contexto del circuito en vez de forzarlo a mitad de otro render.
    /// </summary>
    private void AlCambiarAcciones() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Acciones.Cambio -= AlCambiarAcciones;
}
