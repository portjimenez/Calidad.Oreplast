@using Microsoft.AspNetCore.Components.Authorization

@*
    Menú lateral. Solo ofrece las pantallas que el usuario puede abrir.

    Qué pantallas hay y qué permiso exige cada una lo resuelve MapaPantallas
    (leyendo el [Authorize] de la página destino), el mismo que usan la barra de
    herramientas y la Ayuda. Así hay una sola fuente de verdad.

    Plegado lo controla el botón de menú de la barra de herramientas: deja más
    ancho a las pantallas con tablas grandes (inspección, bitácora).
*@

<nav class="sidebar @(Plegado ? "sidebar--plegado" : null)" aria-hidden="@(Plegado ? "true" : null)">
    <div class="sidebar__explorador">Explorador de objetos</div>

    @foreach (var grupo in _visibles)
    {
        <div class="sidebar__grupo">
            <div class="sidebar__grupo-titulo">@grupo.Titulo</div>
            @foreach (var pantalla in grupo.Pantallas)
            {
                <NavLink class="sidebar__item" href="@pantalla.Href" Match="NavLinkMatch.All">
                    @pantalla.Texto
                </NavLink>
            }
        </div>
    }

    @* Sin pie: "Cerrar sesión" no aplica con Windows Authentication (la credencial
       la conserva el navegador; en desarrollo el usuario se cambia con el selector
       de la barra de título). *@
</nav>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    [Parameter] public bool Plegado { get; set; }

    private List<MapaPantallas.Grupo> _visibles = [];

    protected override async Task OnParametersSetAsync()
    {
        _visibles = EstadoAutenticacion is null
            ? []
            : MapaPantallas.VisiblesPara((await EstadoAutenticacion).User);
    }
}
