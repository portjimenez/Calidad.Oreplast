<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    @* Font Awesome Free (íconos de la barra de herramientas), servido desde la
       propia aplicación y no desde un CDN: en la red interna de la planta no se
       puede contar con salida a internet. Solo el núcleo y el estilo Solid. *@
    <link rel="stylesheet" href="@Assets["lib/fontawesome/css/fontawesome.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/fontawesome/css/solid.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/oreplast-theme.css"]" />
    <link rel="stylesheet" href="@Assets["calidad-app.styles.css"]" />
    @* Va después del CSS aislado: al imprimir tiene que poder ocultar los
       elementos de todos los componentes, no solo los de uno. *@
    <link rel="stylesheet" href="@Assets["css/impresion.css"]" />
    <ImportMap />
    <link rel="icon" type="image/x-icon" href="img/Oreplast.ico" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
