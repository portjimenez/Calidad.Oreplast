@using calidad_app.Data.Sp
@using calidad_app.Models.Catalogos
@using calidad_app.Services.Catalogos
@using calidad_app.Components.Shared
@inject ICatalogoService Catalogos

@* Máquinas de la planta. Es la pestaña con más reglas: la máquina pertenece a
   un área y a una línea que tienen que coincidir, y su baja depende de que no
   le queden registros de inspección abiertos. *@

<div class="catalogo">
    <div class="catalogo__lista">
        <div class="filtros">
            <input type="search" class="filtros__busqueda"
                   placeholder="Código o nombre…"
                   value="@_busqueda" @onchange="BuscarAsync" />
            <select class="filtros__select" value="@_areaFiltro" @onchange="CambiarAreaFiltroAsync">
                <option value="0">Todas las áreas</option>
                @foreach (var area in Selectores.Areas)
                {
                    <option value="@area.AreaId">@area.Nombre</option>
                }
            </select>
            <label class="filtros__check">
                <input type="checkbox" checked="@_soloActivas" @onchange="CambiarSoloActivasAsync" />
                Solo activas
            </label>
            <button type="button" class="boton boton--primario filtros__nuevo" @onclick="AbrirAlta">
                Nueva máquina
            </button>
        </div>

        <table class="tabla-maestro">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Área</th>
                    <th>Línea</th>
                    <th class="tabla-maestro__num">Registros</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (_cargando)
                {
                    <tr><td colspan="6" class="tabla-maestro__vacio">Cargando máquinas…</td></tr>
                }
                else if (_maquinas.Count == 0)
                {
                    <tr><td colspan="6" class="tabla-maestro__vacio">Sin máquinas que coincidan.</td></tr>
                }
                else
                {
                    @foreach (var maquina in _pag.Elementos)
                    {
                        <tr class="@ClaseFila(maquina)" @onclick="() => Seleccionar(maquina)">
                            <td><span class="tabla-maestro__principal">@maquina.Codigo</span></td>
                            <td>@maquina.Nombre</td>
                            <td>@maquina.AreaNombre</td>
                            <td>@(maquina.LineaNombre ?? "Sin línea")</td>
                            <td class="tabla-maestro__num">
                                @maquina.Registros
                                @if (maquina.RegistrosAbiertos > 0)
                                {
                                    <span class="tabla-maestro__secundario">@maquina.RegistrosAbiertos abiertos</span>
                                }
                            </td>
                            <td>
                                <EstadoChip Texto="@(maquina.Activo ? "Activa" : "Retirada")"
                                            Tono="@(maquina.Activo ? TonoChip.Exito : TonoChip.Neutro)" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <Paginador Estado="_pag" Cargando="_cargando" PaginaCambiada="StateHasChanged" />
    </div>

    <div class="catalogo__ficha">
        @if (_error is not null)
        {
            <p class="ficha__error" role="alert">@_error</p>
        }
        @if (_aviso is not null)
        {
            <p class="ficha__aviso" role="status">@_aviso</p>
        }

        <h3 class="ficha__titulo">
            @(_edicion.MaquinaId == 0 ? "Nueva máquina" : $"{_edicion.Codigo} · {_edicion.Nombre}")
        </h3>

        <label class="campo">
            <span>Código</span>
            <input type="text" maxlength="30"
                   value="@_edicion.Codigo"
                   @onchange="e => _edicion.Codigo = e.Value?.ToString() ?? string.Empty" />
        </label>

        <label class="campo">
            <span>Nombre</span>
            <input type="text" maxlength="80"
                   value="@_edicion.Nombre"
                   @onchange="e => _edicion.Nombre = e.Value?.ToString() ?? string.Empty" />
        </label>

        <label class="campo">
            <span>Área</span>
            <select value="@_edicion.AreaId" disabled="@(!PuedeCambiarDeArea)"
                    @onchange="CambiarArea">
                <option value="0">Elija un área…</option>
                @foreach (var area in Selectores.Areas.Where(a => a.Activo || a.AreaId == _edicion.AreaId))
                {
                    <option value="@area.AreaId">@area.Nombre</option>
                }
            </select>
        </label>

        @if (!PuedeCambiarDeArea)
        {
            <p class="ficha__pista">
                La máquina ya tiene @_edicion.Registros registros de inspección, así que su
                área queda fija: cambiarla contaría esa producción en un área donde nunca
                ocurrió. Si la máquina se trasladó, se retira y se da de alta la nueva.
            </p>
        }

        <label class="campo">
            <span>Línea de producción</span>
            <select value="@(_edicion.LineaId ?? 0)"
                    @onchange="e => _edicion.LineaId = LeerIdNulo(e)">
                <option value="0">Sin línea</option>
                @foreach (var linea in LineasDelArea)
                {
                    <option value="@linea.LineaId">@linea.Etiqueta</option>
                }
            </select>
        </label>

        <div class="ficha__acciones">
            <button type="button" class="boton boton--primario"
                    disabled="@_guardando" @onclick="GuardarAsync">
                @(_guardando ? "Guardando…" : "Guardar")
            </button>

            @if (_edicion.MaquinaId != 0)
            {
                <button type="button" class="boton boton--fantasma"
                        disabled="@_guardando" @onclick="AbrirAlta">
                    Cancelar
                </button>

                <button type="button"
                        class="boton @(_edicion.Activo ? "boton--enlace-peligro" : "boton--fantasma")"
                        disabled="@(_guardando || (_edicion.Activo && !_edicion.SePuedeDesactivar))"
                        @onclick="CambiarEstadoAsync">
                    @(_edicion.Activo ? "Retirar del catálogo" : "Reincorporar")
                </button>
            }
        </div>

        @if (_edicion.MaquinaId != 0 && _edicion.Activo && !_edicion.SePuedeDesactivar)
        {
            <p class="ficha__pista">
                No se puede retirar mientras tenga @_edicion.RegistrosAbiertos registros de
                inspección abiertos: la pantalla del operador solo ofrece máquinas activas y
                esos registros se quedarían sin poder cerrarse.
            </p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SelectoresCatalogo Selectores { get; set; } = new();
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<MaquinaCatalogo> _maquinas = [];
    private readonly Paginacion<MaquinaCatalogo> _pag = new();

    /// <summary>Copia de trabajo: la tabla sigue mostrando lo que la base aceptó.</summary>
    private MaquinaCatalogo _edicion = new();

    private string _busqueda = string.Empty;
    private int _areaFiltro;
    private bool _soloActivas;
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;
    private string? _aviso;

    /// <summary>
    /// Las líneas que puede tomar la máquina: solo las de su área, porque el
    /// procedimiento rechaza una línea de otra área. Se conserva la que ya tiene
    /// aunque esté retirada, para no perderla en silencio al guardar.
    /// </summary>
    private IEnumerable<LineaOpcion> LineasDelArea =>
        Selectores.Lineas.Where(l =>
            l.AreaId == _edicion.AreaId && (l.Activo || l.LineaId == _edicion.LineaId));

    private bool PuedeCambiarDeArea => _edicion.MaquinaId == 0 || _edicion.PuedeCambiarDeArea;

    protected override Task OnInitializedAsync() => CargarAsync();

    /// <summary>
    /// Lee la lista. Al cambiar un filtro se vuelve a la primera página: la
    /// página 3 del resultado anterior no significa nada en el resultado nuevo.
    /// Al recargar tras guardar, en cambio, se conserva la posición.
    /// </summary>
    private async Task CargarAsync(bool reiniciarPagina = false)
    {
        _cargando = true;
        _error = null;

        try
        {
            _maquinas = await Catalogos.ListarMaquinasAsync(
                string.IsNullOrWhiteSpace(_busqueda) ? null : _busqueda.Trim(),
                _areaFiltro == 0 ? null : _areaFiltro,
                lineaId: null,
                soloActivos: _soloActivas);

            if (reiniciarPagina)
            {
                _pag.Reiniciar(_maquinas);
            }
            else
            {
                _pag.Actualizar(_maquinas, m => m.MaquinaId == _edicion.MaquinaId && _edicion.MaquinaId != 0);
            }
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task BuscarAsync(ChangeEventArgs e)
    {
        _busqueda = e.Value?.ToString() ?? string.Empty;
        await CargarAsync(reiniciarPagina: true);
    }

    private async Task CambiarAreaFiltroAsync(ChangeEventArgs e)
    {
        _areaFiltro = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await CargarAsync(reiniciarPagina: true);
    }

    private async Task CambiarSoloActivasAsync(ChangeEventArgs e)
    {
        _soloActivas = e.Value is bool valor && valor;
        await CargarAsync(reiniciarPagina: true);
    }

    private void Seleccionar(MaquinaCatalogo maquina)
    {
        _edicion = Copiar(maquina);
        _error = null;
        _aviso = null;
    }

    private void AbrirAlta()
    {
        _edicion = new MaquinaCatalogo
        {
            AreaId = _areaFiltro != 0
                ? _areaFiltro
                : Selectores.Areas.FirstOrDefault(a => a.Activo)?.AreaId ?? 0
        };

        _error = null;
        _aviso = null;
    }

    /// <summary>
    /// Cambiar de área invalida la línea elegida: pertenecía a la anterior. Se
    /// limpia en lugar de dejar que la rechace el procedimiento.
    /// </summary>
    private void CambiarArea(ChangeEventArgs e)
    {
        _edicion.AreaId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _edicion.LineaId = null;
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _error = null;
        _aviso = null;

        try
        {
            var esAlta = _edicion.MaquinaId == 0;
            _edicion.MaquinaId = await Catalogos.GuardarMaquinaAsync(_edicion);
            _aviso = esAlta ? "Máquina creada." : "Cambios guardados.";

            await RecargarAsync();
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CambiarEstadoAsync()
    {
        _guardando = true;
        _error = null;
        _aviso = null;

        try
        {
            var activar = !_edicion.Activo;
            await Catalogos.CambiarEstadoMaquinaAsync(_edicion.MaquinaId, activar);
            _aviso = activar ? "Máquina reincorporada." : "Máquina retirada del catálogo.";

            await RecargarAsync();
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task RecargarAsync()
    {
        await CargarAsync();

        var actual = _maquinas.FirstOrDefault(m => m.MaquinaId == _edicion.MaquinaId);
        if (actual is not null)
        {
            _edicion = Copiar(actual);
        }

        if (OnCambio.HasDelegate)
        {
            await OnCambio.InvokeAsync();
        }
    }

    private static MaquinaCatalogo Copiar(MaquinaCatalogo m) => new()
    {
        MaquinaId = m.MaquinaId,
        Codigo = m.Codigo,
        Nombre = m.Nombre,
        AreaId = m.AreaId,
        AreaNombre = m.AreaNombre,
        AreaActiva = m.AreaActiva,
        LineaId = m.LineaId,
        LineaCodigo = m.LineaCodigo,
        LineaNombre = m.LineaNombre,
        Activo = m.Activo,
        Registros = m.Registros,
        RegistrosAbiertos = m.RegistrosAbiertos,
        UltimoRegistro = m.UltimoRegistro,
        Metas = m.Metas,
        EnUso = m.EnUso
    };

    private string? ClaseFila(MaquinaCatalogo m) =>
        m.MaquinaId == _edicion.MaquinaId && _edicion.MaquinaId != 0
            ? "tabla-maestro__fila--seleccionada"
            : null;

    private static int? LeerIdNulo(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;

    private static string Traducir(Exception ex) => ex switch
    {
        ReglaNegocioException regla => regla.Message,
        _ => "No se pudo completar la operación. Intente de nuevo o avise a sistemas."
    };
}
