@page "/trazabilidad-lote"
@using calidad_app.Data.Sp
@using calidad_app.Models.Calidad
@using OrdenBusqueda = calidad_app.Models.Inspeccion.OrdenBusqueda
@using calidad_app.Services.Calidad
@using calidad_app.Services.Inspeccion
@attribute [Authorize(Policy = "CONSULTAR_TRAZABILIDAD")]
@inject ILoteService ServicioLotes
@inject ICertificadoService ServicioCertificados
@inject NavigationManager Navegacion
@inject IRegistroInspeccionService Registros

<PageTitle>Trazabilidad por lote</PageTitle>

<MaestroDetalle>
    <Maestro>
        <PanelCard Titulo="Lotes de producción">
            <div class="filtros">
                <input type="search" class="filtros__busqueda"
                       placeholder="Código de lote u orden…"
                       value="@_filtro.Busqueda"
                       @onchange="BuscarAsync" />
                <select class="filtros__select" value="@(_filtro.Estado ?? "")"
                        @onchange="CambiarEstadoAsync">
                    <option value="">Todos los estados</option>
                    <option value="@EstadoLote.EnProceso">En proceso</option>
                    <option value="@EstadoLote.Liberado">Liberado</option>
                    <option value="@EstadoLote.Cerrado">Cerrado</option>
                </select>
                <label class="filtros__check">
                    <input type="checkbox"
                           checked="@_filtro.SoloSinCertificado"
                           @onchange="CambiarSoloSinCertificadoAsync" />
                    Por certificar
                </label>
                @if (_puedeLiberar)
                {
                    <button type="button" class="boton boton--primario filtros__nuevo"
                            @onclick="AlternarAlta">
                        @(_modoAlta ? "Cancelar" : "Nuevo lote")
                    </button>
                }
            </div>

            @if (_modoAlta)
            {
                <div class="alta">
                    <p class="alta__pista">
                        Busque la orden sobre la que abrir el lote. El código se genera solo
                        con el formato de la planta (@("<orden>-L01")).
                    </p>
                    <input type="search" class="alta__busqueda"
                           placeholder="Número de OP, producto o cliente…"
                           @onchange="BuscarOrdenesAsync" />

                    @if (_ordenes.Count > 0)
                    {
                        <ul class="alta__resultados">
                            @foreach (var orden in _ordenes)
                            {
                                <li>
                                    <button type="button" class="alta__orden"
                                            disabled="@_guardando"
                                            @onclick="() => CrearLoteAsync(orden)">
                                        <strong>@orden.NumeroOP</strong>
                                        <span>@orden.ClienteNombre · @orden.ProductoCodigo</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else if (_ordenBuscada)
                    {
                        <p class="bloque__vacio">Ninguna orden coincide.</p>
                    }
                </div>
            }

            <table class="tabla-maestro">
                <thead>
                    <tr>
                        <th>Lote</th>
                        <th>Producto</th>
                        <th class="tabla-maestro__num">Bobinas</th>
                        <th class="tabla-maestro__num">Peso</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_cargandoLista)
                    {
                        <tr><td colspan="5" class="tabla-maestro__vacio">Cargando lotes…</td></tr>
                    }
                    else if (_lista.Count == 0)
                    {
                        <tr><td colspan="5" class="tabla-maestro__vacio">Sin lotes que coincidan.</td></tr>
                    }
                    else
                    {
                        @foreach (var lote in _lista)
                        {
                            <tr class="@ClaseFila(lote)" @onclick="() => SeleccionarAsync(lote.LoteId)">
                                <td>
                                    <span class="tabla-maestro__principal">@lote.CodigoLote</span>
                                    <span class="tabla-maestro__secundario">@lote.ClienteNombre</span>
                                </td>
                                <td>
                                    @lote.ProductoCodigo
                                    <span class="tabla-maestro__secundario">@lote.NumeroOP</span>
                                </td>
                                <td class="tabla-maestro__num">
                                    @lote.TotalBobinas
                                    @if (lote.BobinasNoConformes > 0)
                                    {
                                        <span class="tabla-maestro__secundario">
                                            @lote.BobinasNoConformes no conformes
                                        </span>
                                    }
                                </td>
                                <td class="tabla-maestro__num">@Formato(lote.PesoTotal) kg</td>
                                <td>
                                    <EstadoChip Texto="@TextoEstado(lote.Estado)"
                                                Tono="@TonoEstado(lote.Estado)" />
                                    @if (lote.TieneCertificado)
                                    {
                                        <span class="tabla-maestro__secundario">@lote.CertificadoCodigo</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </PanelCard>
    </Maestro>
    <Detalle>
        <PanelCard Titulo="@TituloDetalle">
            <div class="lote">
                @if (_error is not null)
                {
                    <p class="lote__error" role="alert">@_error</p>
                }
                @if (_aviso is not null)
                {
                    <p class="lote__aviso" role="status">@_aviso</p>
                }

                @if (_detalle is null)
                {
                    <p class="lote__placeholder">
                        @(_cargandoDetalle
                            ? "Cargando el lote…"
                            : "Seleccione un lote de la lista para ver su trazabilidad.")
                    </p>
                }
                else
                {
                    <div class="cabecera">
                        <div class="cabecera__identidad">
                            <span class="cabecera__codigo">@_detalle.CodigoLote</span>
                            <EstadoChip Texto="@TextoEstado(_detalle.Estado)"
                                        Tono="@TonoEstado(_detalle.Estado)" />
                            @if (_detalle.TieneCertificado)
                            {
                                <EstadoChip Texto="@($"Certificado {_detalle.CertificadoCodigo}")"
                                            Tono="TonoChip.Exito" />
                            }
                        </div>
                        <span class="cabecera__meta">
                            @_detalle.ClienteNombre · @_detalle.ProductoCodigo · orden @_detalle.NumeroOP
                            @if (_detalle.FechaProduccion is { } fecha)
                            {
                                <text> · producido el @fecha.ToString("dd/MM/yyyy")</text>
                            }
                        </span>
                    </div>

                    <div class="acumulados">
                        <div class="acumulado">
                            <span>Bobinas</span>
                            <strong>@_detalle.TotalBobinas</strong>
                        </div>
                        <div class="acumulado">
                            <span>Peso</span>
                            <strong>@Formato(_detalle.PesoTotal) kg</strong>
                        </div>
                        <div class="acumulado">
                            <span>Metros</span>
                            <strong>@Formato(_detalle.MetrosTotal)</strong>
                        </div>
                        <div class="acumulado @(_detalle.BobinasNoConformes > 0 ? "acumulado--alerta" : null)">
                            <span>No conformes</span>
                            <strong>@_detalle.BobinasNoConformes</strong>
                        </div>
                    </div>

                    <TabStrip Pestanas="_pestanas" @bind-PestanaActiva="_pestanaActiva" />

                    <div class="lote__cuerpo">
                        @if (_pestanaActiva == "bobinas")
                        {
                            @if (_detalle.Bobinas.Count == 0)
                            {
                                <p class="bloque__vacio">El lote todavía no tiene bobinas asignadas.</p>
                            }
                            else
                            {
                                <table class="tabla-bloque">
                                    <thead>
                                        <tr>
                                            <th>Registro</th>
                                            <th class="tabla-bloque__num">Bobina</th>
                                            <th class="tabla-bloque__num">Peso</th>
                                            <th class="tabla-bloque__num">Calibre</th>
                                            <th>Máquina</th>
                                            <th>Estado</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bobina in _detalle.Bobinas)
                                        {
                                            <tr>
                                                <td>@bobina.IdRegistro</td>
                                                <td class="tabla-bloque__num">@bobina.IdBobi</td>
                                                <td class="tabla-bloque__num">@Formato(bobina.Peso)</td>
                                                <td class="tabla-bloque__num">@Formato(bobina.Calibre)</td>
                                                <td>
                                                    @bobina.MaquinaCodigo
                                                    <span class="tabla-bloque__secundario">
                                                        @bobina.TurnoNombre · @bobina.OperadorNombre
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!bobina.EsConforme)
                                                    {
                                                        <EstadoChip Texto="No conforme" Tono="TonoChip.Peligro" />
                                                        <span class="tabla-bloque__secundario">
                                                            @bobina.NoConformidadCodigo
                                                        </span>
                                                    }
                                                    else if (!bobina.Ok)
                                                    {
                                                        <EstadoChip Texto="Con observaciones" Tono="TonoChip.Advertencia" />
                                                    }
                                                    else
                                                    {
                                                        <EstadoChip Texto="Conforme" Tono="TonoChip.Exito" />
                                                    }
                                                </td>
                                                <td class="tabla-bloque__acciones">
                                                    @if (_detalle.AdmiteBobinas && _puedeLiberar)
                                                    {
                                                        <button type="button" class="boton boton--enlace-peligro"
                                                                disabled="@_guardando"
                                                                @onclick="() => QuitarBobinaAsync(bobina)">
                                                            Quitar
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            @if (_detalle.AdmiteBobinas && _puedeLiberar)
                            {
                                <section class="bloque">
                                    <h3 class="bloque__titulo">
                                        Agregar bobinas (@_disponibles.Count disponibles)
                                    </h3>
                                    <p class="bloque__pista">
                                        Solo aparecen las bobinas confirmadas de la orden @_detalle.NumeroOP
                                        que todavía no pertenecen a ningún lote. Una bobina no puede
                                        estar en dos lotes: es la base de la trazabilidad.
                                    </p>

                                    @if (_disponibles.Count == 0)
                                    {
                                        <p class="bloque__vacio">
                                            No hay bobinas confirmadas sin lote en esta orden.
                                        </p>
                                    }
                                    else
                                    {
                                        <table class="tabla-bloque">
                                            <thead>
                                                <tr>
                                                    <th class="tabla-bloque__check"></th>
                                                    <th>Registro</th>
                                                    <th class="tabla-bloque__num">Bobina</th>
                                                    <th class="tabla-bloque__num">Peso</th>
                                                    <th>Confirmada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var bobina in _disponibles)
                                                {
                                                    <tr>
                                                        <td class="tabla-bloque__check">
                                                            <input type="checkbox"
                                                                   checked="@_marcadas.Contains(bobina.BobinaId)"
                                                                   @onchange="e => Marcar(bobina.BobinaId, e)"
                                                                   aria-label="@($"Bobina {bobina.IdBobi}")" />
                                                        </td>
                                                        <td>@bobina.IdRegistro</td>
                                                        <td class="tabla-bloque__num">@bobina.IdBobi</td>
                                                        <td class="tabla-bloque__num">@Formato(bobina.Peso)</td>
                                                        <td>@bobina.FechaConfirmacion?.ToString("dd/MM/yyyy HH:mm")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="bloque__acciones">
                                            <button type="button" class="boton boton--primario"
                                                    disabled="@(_guardando || _marcadas.Count == 0)"
                                                    @onclick="AgregarBobinasAsync">
                                                @(_guardando ? "Guardando…" : $"Agregar {_marcadas.Count} bobina(s)")
                                            </button>
                                        </div>
                                    }
                                </section>
                            }
                        }
                        else if (_pestanaActiva == "origen")
                        {
                            <section class="bloque">
                                <h3 class="bloque__titulo">Registros de inspección de origen</h3>
                                <p class="bloque__pista">
                                    De aquí salieron las bobinas del lote. La firma de liberación se
                                    hace sobre el registro, en su pestaña de despeje.
                                </p>
                                <table class="tabla-bloque">
                                    <thead>
                                        <tr>
                                            <th>Registro</th>
                                            <th>Fecha</th>
                                            <th>Máquina</th>
                                            <th>Liberación</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var registro in _detalle.Registros)
                                        {
                                            <tr>
                                                <td>@registro.IdRegistro</td>
                                                <td>@registro.Fecha.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @registro.MaquinaCodigo
                                                    <span class="tabla-bloque__secundario">
                                                        @registro.TurnoNombre · @registro.OperadorNombre
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (registro.Liberado)
                                                    {
                                                        <EstadoChip Texto="Liberado" Tono="TonoChip.Exito" />
                                                        <span class="tabla-bloque__secundario">
                                                            @registro.LiberadoPorNombre ·
                                                            @registro.FechaLiberacion?.ToString("dd/MM/yyyy HH:mm")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <EstadoChip Texto="Sin liberar" Tono="TonoChip.Advertencia" />
                                                    }
                                                </td>
                                                <td class="tabla-bloque__acciones">
                                                    <button type="button" class="boton boton--fantasma"
                                                            @onclick="() => AbrirRegistro(registro)">
                                                        Abrir
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </section>

                            <section class="bloque">
                                <h3 class="bloque__titulo">
                                    No conformidades del lote (@_detalle.NoConformidades.Count)
                                </h3>
                                @if (_detalle.NoConformidades.Count == 0)
                                {
                                    <p class="bloque__vacio">Sin no conformidades relacionadas.</p>
                                }
                                else
                                {
                                    <table class="tabla-bloque">
                                        <thead>
                                            <tr>
                                                <th>Código</th>
                                                <th>Descripción</th>
                                                <th>Severidad</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var nc in _detalle.NoConformidades)
                                            {
                                                <tr class="tabla-bloque__clicable"
                                                    @onclick="() => AbrirNoConformidad(nc)">
                                                    <td>@nc.Codigo</td>
                                                    <td>@nc.Descripcion</td>
                                                    <td>@TextoSeveridad(nc.SeveridadNombre)</td>
                                                    <td>
                                                        <EstadoChip Texto="@TextoEstadoNc(nc.EstadoNombre)"
                                                                    Tono="@(nc.EsFinal ? TonoChip.Exito : TonoChip.Advertencia)" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </section>

                            <section class="bloque">
                                <h3 class="bloque__titulo">
                                    Alertas de proceso (@_detalle.Alertas.Count)
                                </h3>
                                @if (_detalle.Alertas.Count == 0)
                                {
                                    <p class="bloque__vacio">Sin alertas en los registros del lote.</p>
                                }
                                else
                                {
                                    <table class="tabla-bloque">
                                        <thead>
                                            <tr>
                                                <th>Parámetro</th>
                                                <th>Origen</th>
                                                <th class="tabla-bloque__num">Valor</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var alerta in _detalle.Alertas)
                                            {
                                                <tr>
                                                    <td>
                                                        @alerta.ParametroNombre
                                                        @if (alerta.EsCritico)
                                                        {
                                                            <EstadoChip Texto="Crítico" Tono="TonoChip.Peligro" />
                                                        }
                                                    </td>
                                                    <td>@alerta.IdRegistro · @alerta.OrigenTexto</td>
                                                    <td class="tabla-bloque__num">
                                                        @Formato(alerta.ValorRegistrado) @alerta.Unidad
                                                    </td>
                                                    <td>
                                                        <EstadoChip Texto="@(alerta.Atendida ? "Atendida" : "Pendiente")"
                                                                    Tono="@(alerta.Atendida ? TonoChip.Exito : TonoChip.Advertencia)" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </section>
                        }
                        else if (_pestanaActiva == "certificado")
                        {
                            @if (_detalle.TieneCertificado)
                            {
                                <div class="certificado-emitido">
                                    <strong>Certificado @_detalle.CertificadoCodigo</strong>
                                    <span>
                                        Emitido el @_detalle.CertificadoFecha?.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    <a class="boton boton--primario"
                                       href="@($"/certificados?certificado={_detalle.CertificadoId}")">
                                        Ver el certificado
                                    </a>
                                </div>
                            }
                            else
                            {
                                <section class="bloque">
                                    <h3 class="bloque__titulo">Emitir certificado de calidad</h3>

                                    @if (_detalle.MotivoNoCertificable is { } motivo)
                                    {
                                        <p class="requisito requisito--pendiente">@motivo</p>
                                        <p class="bloque__pista">
                                            Certificar mientras se investiga un defecto sería afirmar por
                                            escrito algo que todavía no se sabe. Las no conformidades ya
                                            cerradas no bloquean: se investigaron, y eso es justamente
                                            lo que el certificado respalda.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="requisito requisito--ok">
                                            El lote está liberado, tiene @_detalle.TotalBobinas bobinas y no
                                            le quedan no conformidades abiertas.
                                        </p>
                                    }

                                    <AuthorizeView Policy="GENERAR_CERTIFICADO" Context="emision">
                                        <Authorized>
                                            <label class="campo">
                                                <span>Observaciones del certificado (opcional)</span>
                                                <textarea rows="2" maxlength="1000"
                                                          value="@_observacionesCertificado"
                                                          @onchange="e => _observacionesCertificado = e.Value?.ToString() ?? string.Empty"></textarea>
                                            </label>
                                            <div class="bloque__acciones">
                                                <button type="button" class="boton boton--primario"
                                                        disabled="@(_guardando || !_detalle.PuedeCertificarse)"
                                                        @onclick="EmitirCertificadoAsync">
                                                    @(_guardando ? "Emitiendo…" : "Emitir certificado")
                                                </button>
                                            </div>
                                        </Authorized>
                                        <NotAuthorized>
                                            <p class="bloque__pista">
                                                Solo Ingeniería de Calidad puede emitir certificados.
                                            </p>
                                        </NotAuthorized>
                                    </AuthorizeView>
                                </section>
                            }
                        }
                    </div>
                }
            </div>
        </PanelCard>
    </Detalle>
</MaestroDetalle>

@code {
    [SupplyParameterFromQuery(Name = "lote")]
    private int? LoteInicial { get; set; }

    private readonly FiltroLotes _filtro = new();
    private readonly List<TabItem> _pestanas =
    [
        new("bobinas", "Bobinas"),
        new("origen", "Origen y calidad"),
        new("certificado", "Certificado")
    ];

    private List<LoteResumen> _lista = [];
    private LoteDetalle? _detalle;
    private List<BobinaDisponible> _disponibles = [];
    private readonly HashSet<int> _marcadas = [];

    private string _pestanaActiva = "bobinas";
    private string _observacionesCertificado = string.Empty;
    private bool _puedeLiberar;
    private bool _modoAlta;
    private bool _ordenBuscada;
    private List<OrdenBusqueda> _ordenes = [];

    private bool _cargandoLista = true;
    private bool _cargandoDetalle;
    private bool _guardando;
    private string? _error;
    private string? _aviso;

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is not null)
        {
            var estado = await EstadoAutenticacion;
            _puedeLiberar = estado.User.HasClaim("permiso", "LIBERAR_PRODUCTO");
        }

        await CargarListaAsync();

        if (LoteInicial is { } id)
        {
            await SeleccionarAsync(id);
        }
    }

    private async Task CargarListaAsync()
    {
        _cargandoLista = true;
        _error = null;

        try
        {
            _lista = await ServicioLotes.ListarAsync(_filtro);
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _cargandoLista = false;
        }
    }

    private async Task SeleccionarAsync(int loteId)
    {
        _cargandoDetalle = true;
        _error = null;
        _aviso = null;
        _marcadas.Clear();
        _observacionesCertificado = string.Empty;

        try
        {
            await AplicarDetalleAsync(await ServicioLotes.ObtenerAsync(loteId));
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _cargandoDetalle = false;
        }
    }

    /// <summary>
    /// Refresca el lote y, si todavía admite bobinas, la lista de candidatas.
    /// Un lote liberado ya no admite ninguna, así que no tiene sentido pedirlas.
    /// </summary>
    private async Task AplicarDetalleAsync(LoteDetalle? detalle)
    {
        _detalle = detalle;
        _marcadas.Clear();

        _disponibles = detalle is { AdmiteBobinas: true }
            ? await ServicioLotes.ListarBobinasDisponiblesAsync(detalle.LoteId)
            : [];
    }

    private async Task AgregarBobinasAsync()
    {
        if (_detalle is null)
        {
            return;
        }

        await EjecutarAsync(async () =>
        {
            var agregadas = _marcadas.Count;
            await AplicarDetalleAsync(
                await ServicioLotes.AsignarBobinasAsync(_detalle.LoteId, _marcadas.ToList()));

            _aviso = $"Se agregaron {agregadas} bobina(s) al lote.";
            await CargarListaAsync();
        });
    }

    private async Task QuitarBobinaAsync(BobinaDeLote bobina)
    {
        if (_detalle is null)
        {
            return;
        }

        await EjecutarAsync(async () =>
        {
            await AplicarDetalleAsync(await ServicioLotes.AsignarBobinasAsync(
                _detalle.LoteId, [bobina.BobinaId], asignar: false));

            _aviso = $"La bobina {bobina.IdBobi} salió del lote.";
            await CargarListaAsync();
        });
    }

    private async Task EmitirCertificadoAsync()
    {
        if (_detalle is null)
        {
            return;
        }

        await EjecutarAsync(async () =>
        {
            var emitido = await ServicioCertificados.EmitirAsync(
                _detalle.LoteId, Vacio(_observacionesCertificado));

            _aviso = $"Se emitió el certificado {emitido.Codigo}. El lote queda cerrado.";
            _observacionesCertificado = string.Empty;

            await AplicarDetalleAsync(await ServicioLotes.ObtenerAsync(_detalle.LoteId));
            await CargarListaAsync();
        });
    }

    private async Task EjecutarAsync(Func<Task> accion)
    {
        _guardando = true;
        _error = null;
        _aviso = null;

        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            _error = Traducir(ex);
        }
        finally
        {
            _guardando = false;
        }
    }

    private void AbrirRegistro(RegistroDeLote registro) =>
        Navegacion.NavigateTo(
            $"/inspeccion-en-proceso?registro={registro.RegistroId}&pestana=despeje");

    private void AbrirNoConformidad(NoConformidadDeLote nc) =>
        Navegacion.NavigateTo($"/no-conformidades?nc={nc.NoConformidadId}");

    private void Marcar(int bobinaId, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _marcadas.Add(bobinaId);
        }
        else
        {
            _marcadas.Remove(bobinaId);
        }
    }

    private void AlternarAlta()
    {
        _modoAlta = !_modoAlta;
        _ordenes = [];
        _ordenBuscada = false;
        _error = null;
    }

    private async Task BuscarOrdenesAsync(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(texto))
        {
            _ordenes = [];
            _ordenBuscada = false;
            return;
        }

        await EjecutarAsync(async () =>
        {
            // Se reutiliza el buscador del módulo 2: excluye las órdenes cerradas,
            // que son justamente sobre las que no se puede abrir un lote.
            _ordenes = await Registros.BuscarOrdenesAsync(texto);
            _ordenBuscada = true;
        });
    }

    private async Task CrearLoteAsync(OrdenBusqueda orden)
    {
        await EjecutarAsync(async () =>
        {
            var creado = await ServicioLotes.CrearAsync(orden.OrdenId);

            _modoAlta = false;
            _ordenes = [];
            _ordenBuscada = false;

            await CargarListaAsync();
            await SeleccionarAsync(creado.LoteId);

            _aviso = $"Se creó el lote {creado.CodigoLote}. Agréguele las bobinas confirmadas.";
        });
    }

    private async Task BuscarAsync(ChangeEventArgs e)
    {
        _filtro.Busqueda = e.Value?.ToString();
        await CargarListaAsync();
    }

    private async Task CambiarEstadoAsync(ChangeEventArgs e)
    {
        _filtro.Estado = Vacio(e.Value?.ToString() ?? string.Empty);
        await CargarListaAsync();
    }

    private async Task CambiarSoloSinCertificadoAsync(ChangeEventArgs e)
    {
        _filtro.SoloSinCertificado = e.Value is true;
        await CargarListaAsync();
    }

    private string TituloDetalle =>
        _detalle is null ? "Trazabilidad" : $"Lote {_detalle.CodigoLote}";

    private string ClaseFila(LoteResumen lote) =>
        lote.LoteId == _detalle?.LoteId ? "tabla-maestro__fila--seleccionada" : string.Empty;

    private static string TextoEstado(string estado) => estado switch
    {
        EstadoLote.EnProceso => "En proceso",
        EstadoLote.Liberado => "Liberado",
        EstadoLote.Cerrado => "Certificado",
        var otro => otro
    };

    private static TonoChip TonoEstado(string estado) => estado switch
    {
        EstadoLote.Cerrado => TonoChip.Exito,
        EstadoLote.Liberado => TonoChip.Advertencia,
        _ => TonoChip.Neutro
    };

    private static string TextoEstadoNc(string estado) => estado switch
    {
        "EnAnalisis" => "En análisis",
        "AccionImplementada" => "Acción implementada",
        var otro => otro
    };

    private static string TextoSeveridad(string severidad) => severidad switch
    {
        "Critica" => "Crítica",
        var otra => otra
    };

    private static string Formato(decimal? valor) => valor?.ToString("0.###") ?? "-";

    private static string? Vacio(string texto) => string.IsNullOrWhiteSpace(texto) ? null : texto;

    private static string Traducir(Exception ex) => ex switch
    {
        ReglaNegocioException regla => regla.Message,
        _ => "No se pudo completar la operación. Intente de nuevo o avise a sistemas."
    };
}
