@page "/ayuda"
@using System.Reflection
@using System.Security.Claims
@using calidad_app.Components.Layout
@inject IWebHostEnvironment Entorno

<PageTitle>Ayuda</PageTitle>

@* Ayuda del sistema.

   No exige permiso propio (basta con haber entrado: lo cubre el FallbackPolicy),
   pero lo que muestra depende del usuario: cada persona ve la ayuda de las
   pantallas que puede abrir, leídas de MapaPantallas, igual que el menú. Así la
   guía nunca le describe a un operador una pantalla a la que no va a poder
   entrar, y una pantalla nueva aparece aquí sin tocar este archivo. *@

<div class="ayuda">
    <PanelCard Titulo="Sus pantallas">
        @if (_grupos.Count == 0)
        {
            <p class="ayuda__nota">Su rol no tiene pantallas asignadas. Consulte al Administrador del sistema.</p>
        }
        else
        {
            <p class="ayuda__nota">
                Estas son las pantallas que su rol (@_rol) le permite abrir. Si necesita otra,
                pídala al Administrador: el menú solo muestra lo que su rol tiene autorizado.
            </p>

            @foreach (var grupo in _grupos)
            {
                <h3 class="ayuda__grupo">@grupo.Titulo</h3>
                <dl class="ayuda__lista">
                    @foreach (var pantalla in grupo.Pantallas)
                    {
                        <dt><a href="@pantalla.Href">@pantalla.Texto</a></dt>
                        <dd>@pantalla.Descripcion</dd>
                    }
                </dl>
            }
        }
    </PanelCard>

    <div class="ayuda__lateral">
        <PanelCard Titulo="Barra de herramientas">
            <dl class="ayuda__botones">
                <dt><i class="fa-solid fa-bars" aria-hidden="true"></i> Menú</dt>
                <dd>Oculta o muestra el menú lateral, para dar más espacio a las tablas anchas.</dd>

                <dt><i class="fa-solid fa-arrow-rotate-right" aria-hidden="true"></i> Actualizar</dt>
                <dd>
                    Vuelve a leer los datos de la pantalla. En el panel, los indicadores, el control
                    de desperdicio y los reportes conserva los filtros aplicados; en las demás
                    pantallas la vuelve a abrir desde el principio.
                </dd>

                <dt><i class="fa-solid fa-download" aria-hidden="true"></i> Exportar</dt>
                <dd>
                    Descarga a Excel el reporte en pantalla. Solo está disponible en Reportes; cada
                    descarga queda registrada en la bitácora.
                </dd>

                <dt><i class="fa-solid fa-print" aria-hidden="true"></i> Imprimir</dt>
                <dd>
                    Imprime la pantalla sin el menú ni las barras. Con un certificado abierto se
                    imprime solo el certificado.
                </dd>

                @if (_puedeVerReportes)
                {
                    <dt><i class="fa-solid fa-chart-column" aria-hidden="true"></i> Reportes</dt>
                    <dd>Abre el centro de reportes.</dd>
                }
            </dl>
        </PanelCard>

        <PanelCard Titulo="Acerca de">
            <dl class="ayuda__datos">
                <dt>Sistema</dt>
                <dd>Control de Calidad · Oreplast, S.A.</dd>

                <dt>Versión</dt>
                <dd>@Version</dd>

                <dt>Usuario</dt>
                <dd>@_usuario</dd>

                <dt>Rol</dt>
                <dd>@_rol</dd>

                @if (Entorno.IsDevelopment())
                {
                    <dt>Entorno</dt>
                    <dd>Desarrollo (usuario de dominio simulado)</dd>
                }
            </dl>
        </PanelCard>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private List<MapaPantallas.Grupo> _grupos = [];
    private string _usuario = "—";
    private string _rol = "sin rol";
    private bool _puedeVerReportes;

    /// <summary>La versión del ensamblado (la que sale de compilar), no un texto escrito a mano que se olvide actualizar.</summary>
    private static readonly string Version =
        typeof(Ayuda).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
            .Split('+')[0]
        ?? typeof(Ayuda).Assembly.GetName().Version?.ToString()
        ?? "—";

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacion is null)
        {
            return;
        }

        var usuario = (await EstadoAutenticacion).User;

        _grupos = MapaPantallas.VisiblesPara(usuario);
        _usuario = usuario.Identity?.Name ?? "—";
        _rol = usuario.FindFirst(ClaimTypes.Role)?.Value ?? "sin rol";
        _puedeVerReportes = MapaPantallas.PuedeAbrir(usuario, "/reportes");
    }
}
