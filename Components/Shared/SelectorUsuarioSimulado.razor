@* Solo se renderiza en Development. Cambia de usuario/rol simulado con una navegación real
   (GET /dev/simular), igual que un login real, para que la autorización a nivel de página
   (AuthorizeRouteView/FallbackPolicy) se re-evalúe correctamente. *@
@using calidad_app.Models.Administracion
@inject SimuladorIdentidadService Simulador
@inject IHttpContextAccessor HttpContextAccessor

<select class="selector-usuario-simulado" title="Usuario simulado (solo desarrollo)"
        onchange="location.href='/dev/simular?usuario=' + encodeURIComponent(this.value)">
    @foreach (var usuario in _usuarios)
    {
        <option value="@usuario.UsuarioDominio" selected="@(usuario.UsuarioDominio == _actual)">
            @Etiqueta(usuario)
        </option>
    }
</select>

@code {
    private List<UsuarioSimulado> _usuarios = new();
    private string? _actual;

    protected override async Task OnInitializedAsync()
    {
        _actual = HttpContextAccessor.HttpContext?.Request.Cookies[SimulacionConstantes.CookieUsuario];
        _usuarios = await Simulador.ObtenerUsuariosDisponiblesAsync(_actual);
    }

    /// <summary>
    /// "Operador · Extrusión · 153 - JOSE VICENTE": a los operadores se les antepone su número
    /// de colaborador, el mismo con que aparecen en los registros. Sin área, solo rol y nombre.
    /// </summary>
    private static string Etiqueta(UsuarioSimulado usuario)
    {
        var nombre = usuario.RolNombre == "Operador"
            ? $"{usuario.Codigo} - {usuario.NombreCompleto}"
            : usuario.NombreCompleto;

        return string.IsNullOrEmpty(usuario.AreaNombre)
            ? $"{usuario.RolNombre} · {nombre}"
            : $"{usuario.RolNombre} · {TextosAdministracion.Area(usuario.AreaNombre)} · {nombre}";
    }
}
